{
  "manifest_version": 3,
  "name": "XKCD Toolbar",
  "version": "1.5.0",
  "description": "Unofficial xkcd toolbar: keyboard navigation, instant prev/next, hover text, Explain XKCD, download, read tracking & favorites.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://xkcd.com/*", "https://www.xkcd.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
