{
  "manifest_version": 3,
  "name": "XKCD Toolbar",
  "version": "1.1.0",
  "description": "Navigation, Explain XKCD, and comic image download tools for xkcd.com.",
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://xkcd.com/*", "https://www.xkcd.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
